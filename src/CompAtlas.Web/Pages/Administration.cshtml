@page
@model AdministrationModel
@{ViewData["Title"]="Administration";}
<h1>Administration</h1><p>Administrator access configures the service. Project review and portfolio reading require separate role bindings.</p><div asp-validation-summary="All" role="alert"></div>
@if(Model.IssuedSecret != null){<div class="notice" role="status"><h2>New machine credential</h2><p>Store this secret in an approved pipeline secret store now. It is shown only in this response and expires after 90 days.</p><code>@Model.IssuedSecret</code></div>}
<h2>Connections</h2>@foreach(var c in Model.Connections){<form method="post" asp-page-handler="Discover"><input type="hidden" name="id" value="@c.Id"/><p>@c.Name · <code>@c.Id</code> · @c.BaseUrl · API @c.ApiVersion</p><button type="submit">Discover @c.Name</button></form>}
<form method="post" asp-page-handler="Connection"><label for="connection-name">Connection name</label><input id="connection-name" name="Name" required maxlength="200"/><label for="connection-url">Azure DevOps collection HTTPS URL</label><input id="connection-url" name="BaseUrl" type="url" required/><p>The host must be explicitly allowed in the server configuration.</p><button type="submit">Add collection connection</button></form>
<h2>Project identifiers</h2><ul>@foreach(var p in Model.Projects){<li>@p.Name: <code>@p.Id</code> (Azure DevOps: @p.ExternalId)</li>}</ul>
<h2>AD group roles</h2><form method="post" asp-page-handler="Role"><label asp-for="GroupSid">AD group SID</label><input asp-for="GroupSid" required/><label asp-for="Role">Role</label><select asp-for="Role" asp-items="Html.GetEnumSelectList<AccessRole>()"></select><label for="role-project">Project (project roles only)</label><select id="role-project" name="ProjectId"><option value="">Global role</option>@foreach(var p in Model.Projects){<option value="@p.Id">@p.Name</option>}</select><button type="submit">Grant role</button></form>
<ul>@foreach(var b in Model.Bindings){<li>@b.GroupSid · @b.Role · @(b.ProjectId?.ToString() ?? "Global")<form method="post" asp-page-handler="RevokeRole"><input type="hidden" name="id" value="@b.Id"/><button type="submit">Revoke binding @b.Id</button></form></li>}</ul>
<h2>Machine credentials</h2><form method="post" asp-page-handler="Credential"><label for="credential-name">Credential name</label><input id="credential-name" name="Name" required maxlength="200"/><label for="credential-project">Project scope</label><select id="credential-project" name="ProjectId" required>@foreach(var p in Model.Projects){<option value="@p.Id">@p.Name</option>}</select><label><input asp-for="CanCollect"/> Allow claiming collection jobs</label><button type="submit">Issue a project credential</button></form>
<ul>@foreach(var c in Model.Credentials){<li>@c.Name · @c.ProjectId · expires @c.ExpiresAt.ToString("u") · @(c.Revoked ? "Revoked" : "Active")@if(!c.Revoked){<form method="post" asp-page-handler="RevokeCredential"><input type="hidden" name="id" value="@c.Id"/><button type="submit">Revoke @c.Name</button></form>}</li>}</ul>
<p>Schedules, retention and concurrency are operator-managed configuration. License policies are configured in Dependency-Track; unknown licenses always require review.</p>
