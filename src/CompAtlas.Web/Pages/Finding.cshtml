@page "{id:guid}"
@model FindingModel
@{ViewData["Title"]="Finding"; var f=Model.Finding!;}
<h1>@f.Title</h1>
@if(TempData["Message"] is string message){<p class="notice" role="status">@message</p>}
<dl><dt>Location</dt><dd>@f.Project / @f.Repository / @f.Application</dd><dt>Package</dt><dd>@f.Ecosystem @f.Package @f.Version</dd><dt>Type / severity</dt><dd>@f.Kind / @f.Severity</dd><dt>Evidence</dt><dd>@f.Detail</dd><dt>Analysis</dt><dd>@f.Assessment · @f.SyncStatus</dd><dt>Exception</dt><dd>@(f.AcceptedUntil?.ToString("u") ?? "No active exception")</dd><dt>Snapshot</dt><dd><code>@f.Commit</code> · Build @(f.Build ?? "unknown") · Release @(f.Release ?? "none")</dd></dl>
@if(Model.Component is {} component){<h2>Dependency evidence</h2><dl><dt>Package URL</dt><dd>@(component.Purl ?? "Unknown")</dd><dt>Origin</dt><dd>@(component.Origin ?? "Not evidenced")</dd><dt>Confidence</dt><dd>@component.Confidence</dd></dl><p>Recorded dependencies: @(Model.Dependencies.Count == 0 ? "None recorded; completeness is not established." : string.Join(", ",Model.Dependencies.Select(c=>c.Name+" "+c.Version)))</p>}
<h2>Remediation</h2><p>@(Model.Recommendation ?? "No remediation recommendation was supplied by the analysis source. Review the affected package and advisory evidence.")</p>
@if(Model.CanReview){<h2>Record a review</h2><div asp-validation-summary="All" role="alert"></div><form method="post"><input type="hidden" asp-for="PreviousReviewId"/>
<label asp-for="Assessment">Assessment</label><select asp-for="Assessment" asp-items="Html.GetEnumSelectList<Assessment>()"></select>
<label asp-for="Reason">Reason</label><textarea asp-for="Reason" required maxlength="4000"></textarea>
<label><input asp-for="AcceptRisk"/> Accept this risk temporarily</label><label asp-for="AcceptedUntil">Exception expiry (UTC)</label><input asp-for="AcceptedUntil" type="datetime-local"/>
<p>Scope: this application snapshot and package version. Other repositories and releases require their own assessment.</p><button type="submit">Save review</button></form>}
@if(Model.CanReview && Model.Component?.Hash != null){<h2>Identify a component from file evidence</h2><p>A declaration creates a new analysis snapshot and preserves the original file hash and SBOM.</p><form method="post" asp-page-handler="Declare"><label asp-for="PackageName">Verified package name</label><input asp-for="PackageName" required/><label asp-for="PackageVersion">Verified version</label><input asp-for="PackageVersion" required/><label for="declaration-ecosystem">Ecosystem</label><select id="declaration-ecosystem" name="Ecosystem"><option value="npm">npm</option><option value="nuget">NuGet</option><option value="pypi">PyPI</option></select><label asp-for="DeclaredLicense">License expression (optional)</label><input asp-for="DeclaredLicense"/><label for="declaration-reason">Evidence and reason</label><textarea id="declaration-reason" name="Reason" required maxlength="4000"></textarea><button type="submit">Record verified declaration</button></form>}
<h2>Review history</h2><div class="table-scroll" role="region" aria-label="Review history" tabindex="0"><table><caption>Recorded decisions and synchronization</caption><thead><tr><th scope="col">Date</th><th scope="col">Reviewer</th><th scope="col">Assessment</th><th scope="col">Reason</th><th scope="col">Exception expiry</th><th scope="col">Synchronization</th></tr></thead><tbody>@foreach(var r in Model.History){<tr><td>@r.CreatedAt.ToString("u")</td><td>@r.ActorName</td><td>@r.Assessment</td><td>@r.Reason</td><td>@(r.AcceptedUntil?.ToString("u") ?? "None")</td><td>@r.SyncState</td></tr>}</tbody></table></div>
